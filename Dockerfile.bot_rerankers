FROM python:3.10-slim

WORKDIR /app

# System-level dependencies required by pyodbc (even if DB is only used in tests)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        gnupg \
        unixodbc \
        unixodbc-dev && \
    curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - && \
    curl https://packages.microsoft.com/config/debian/11/prod.list \
        > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 && \
    rm -rf /var/lib/apt/lists/*


# Copy application code
COPY . /app

# Install base Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install heavy reranker-specific dependencies
COPY requirements_bot_rerankers.txt .
RUN pip install --no-cache-dir -r requirements_bot_rerankers.txt

EXPOSE 8080
CMD ["python", "main.py"]
